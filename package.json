{
	"name": "webp-converter",
	"version": "0.1.2",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"dist": "electron-builder --publish never",
		"dist:unsigned": "electron-builder --config.mac.notarize=false --config.mac.identity=null --publish never",
		"release": "electron-builder --publish always"
	},
	"build": {
		"appId": "com.platin.engineer",
		"productName": "Engineer",
		"asar": false,
		"files": [
			"**/*",
			"!template/template_code"
		],
		"extraResources": [
			{
				"from": "template/template_code",
				"to": "template/template_code"
			}
		],
		"publish": [
			{
				"provider": "github",
				"owner": "Marcoslpz11",
				"repo": "engineer-mac"
			}
		],
		"mac": {
			"category": "public.app-category.productivity",
			"icon": "images/logo.icns",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"notarize": {
				"teamId": "9F66FB5N7Y"
			},
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"arm64"
					]
				}
			]
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	},
	"devDependencies": {
		"electron": "^25.9.8",
		"electron-builder": "^24.0.0",
		"electron-rebuild": "^3.2.9"
	},
	"dependencies": {
		"clean-css": "^5.3.3",
		"electron-updater": "^6.8.9",
		"js-beautify": "^1.15.4",
		"sass": "^1.93.2",
		"sharp": "^0.34.4",
		"svgo": "^4.0.1",
		"terser": "^5.44.0"
	}
}
